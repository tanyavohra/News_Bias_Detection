{
  "name": "news-bias-checker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:python\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:python": "python -m uvicorn analysis_service.main:app --reload --port 8000",
    "dev:client": "vite",
    "dev:server": "node server.js",
    "build": "vite build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "dotenv": "^18.0.9",
    "express": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  }
}
